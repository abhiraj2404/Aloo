enum OrderStatus {
    PENDING
    CONFIRMED
    PREPARING
    COMPLETED
    CANCELLED
}

enum OrderType {
    DINE_IN
    TAKEAWAY
    DELIVERY
}

enum BillStatus {
    GENERATED
    PARTIALLY_PAID
    PAID
    CANCELLED
}

enum OrderItemStatus {
    PENDING
    READY
    SERVED
    HOLD
    VOID
}

enum DiscountType {
    PERCENT // value in basis points (0-10000)
    FLAT    // value in paise
}

enum PaymentMode {
    CASH
    CARD
    UPI
    WALLET
    OTHER
}

enum AuditAction {
    BILL_GENERATED
    BILL_DISCOUNT_APPLIED
    BILL_DISCOUNT_CLEARED
    BILL_PAYMENT_RECORDED
    BILL_CANCELLED
    BILL_PRINTED
    BILL_WHATSAPP_SENT
    BILL_SPLIT
    ORDER_MOVED
}

model TableSession {
    id         String    @id @default(cuid())
    tableId    String
    shopId     String
    userId     String?
    customerId String?
    pax        Int?
    startedAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    endedAt    DateTime?

    shop     Shop      @relation(fields: [shopId], references: [id])
    table    Table     @relation(fields: [tableId], references: [id])
    user     User?     @relation(fields: [userId], references: [id])
    customer Customer? @relation(fields: [customerId], references: [id])

    orders Order[]
    bills  Bill[]

    @@index([shopId, tableId])
    @@index([endedAt])
    @@index([customerId])
}

model Order {
    id             String      @id @default(cuid())
    shopId         String
    tableSessionId String?
    userId         String?
    customerId     String?
    totalAmount    Int
    status         OrderStatus @default(PENDING)
    orderType      OrderType   @default(DINE_IN)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    orderItems OrderItem[]
    kot        Kot?

    shop         Shop          @relation(fields: [shopId], references: [id])
    tableSession TableSession? @relation(fields: [tableSessionId], references: [id])
    user         User?         @relation(fields: [userId], references: [id])
    customer     Customer?     @relation(fields: [customerId], references: [id])

    @@index([shopId, createdAt])
    @@index([tableSessionId])
    @@index([userId, createdAt])
    @@index([customerId, createdAt])
}

model OrderItem {
    id       String @id @default(cuid())
    orderId  String
    itemId   String
    name     String
    price    Int    // unit price = (variant price OR item.price) + sum(addon prices)
    quantity Int

    // Customization snapshots (nullable — items without variants/addons leave these null)
    variantId   String?
    variantName String?
    addons      Json?  // [{ name, price }] — frozen at order time

    // Per-item kitchen state — used by Kitchen Display in Phase 3.
    // Defaults PENDING on creation; flipped by kitchen as items are made.
    status OrderItemStatus @default(PENDING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    order     Order      @relation(fields: [orderId], references: [id])
    item      Item       @relation(fields: [itemId], references: [id])
    billItems BillItem[]

    @@index([orderId])
    @@index([itemId])
}

model Bill {
    id             String  @id @default(cuid())
    shopId         String
    tableSessionId String
    customerId     String?

    // Split-bill linkage. Parent bills (the canonical bill for a session) have
    // parentBillId = null. Children are created via /bill/:id/split and reference
    // their parent here. A session has at most one parent bill but N children.
    parentBillId String?

    billNumber String // e.g. "FY25-26/0001" — unique per shop

    subtotal Int

    discountType   DiscountType?
    discountValue  Int           @default(0) // bp if PERCENT, paise if FLAT
    discountAmount Int           @default(0) // computed paise

    cgstAmount          Int @default(0)
    sgstAmount          Int @default(0)
    serviceChargeAmount Int @default(0)

    roundOff    Int @default(0) // can be negative
    tipAmount   Int @default(0) // paise; added on top of rounded total
    totalAmount Int
    paidAmount  Int @default(0)

    notes           String?    // optional customer-facing note; printed on receipt
    status          BillStatus @default(GENERATED)
    cancelledReason String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    shop         Shop         @relation(fields: [shopId], references: [id])
    tableSession TableSession @relation(fields: [tableSessionId], references: [id])
    customer     Customer?    @relation(fields: [customerId], references: [id])
    payments     Payment[]
    parent       Bill?        @relation("BillSplit", fields: [parentBillId], references: [id])
    children     Bill[]       @relation("BillSplit")
    billItems    BillItem[]

    @@unique([shopId, billNumber])
    @@index([tableSessionId])
    @@index([parentBillId])
    @@index([shopId, createdAt])
    @@index([customerId])
}

// BillItem maps an OrderItem to the specific Bill that should be charged for it.
// Used only when a Bill has been split — non-split bills leave billItems empty and
// reuse the full session items list (preserves the original behavior for non-split flows).
model BillItem {
    id          String @id @default(cuid())
    billId      String
    orderItemId String

    bill      Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
    orderItem OrderItem @relation(fields: [orderItemId], references: [id])

    @@unique([billId, orderItemId])
    @@index([billId])
    @@index([orderItemId])
}

model Customer {
    id         String   @id @default(cuid())
    shopId     String
    phone      String                          // E.164, e.g. "+919876543210"
    name       String?
    email      String?
    visits     Int      @default(0)
    totalSpent Int      @default(0)            // paise — sum of paid bills
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    shop          Shop           @relation(fields: [shopId], references: [id])
    tableSessions TableSession[]
    orders        Order[]
    bills         Bill[]

    @@unique([shopId, phone])
    @@index([shopId, createdAt])
}

model Payment {
    id        String      @id @default(cuid())
    billId    String
    shopId    String
    mode      PaymentMode
    amount    Int // paise
    reference String?     // txn id for UPI/card
    notes     String?
    createdAt DateTime    @default(now())

    bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
    shop Shop @relation(fields: [shopId], references: [id])

    @@index([billId])
    @@index([shopId, createdAt])
}

model BillNumberSequence {
    id            String @id @default(cuid())
    shopId        String
    financialYear String // "FY25-26"
    lastNumber    Int    @default(0)

    shop Shop @relation(fields: [shopId], references: [id])

    @@unique([shopId, financialYear])
}

model AuditLog {
    id       String      @id @default(cuid())
    shopId   String
    userId   String?
    action   AuditAction
    entity   String // "BILL"
    entityId String
    metadata Json?

    createdAt DateTime @default(now())

    shop Shop  @relation(fields: [shopId], references: [id])
    user User? @relation(fields: [userId], references: [id])

    @@index([shopId, createdAt])
    @@index([entity, entityId])
}
